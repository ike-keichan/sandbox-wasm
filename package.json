{
  "name": "sandbox-wasm",
  "version": "0.1.0",
  "description": "JavaScript から WebAssembly を呼び出すプロジェクトのひな形",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "start": "node scripts/build.js && node src/main.js",
    "test": "node scripts/build.js && node --test",
    "check": "eslint . && prettier --check .",
    "fix": "eslint --fix . && prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "wabt": "1.0.39"
  }
}
